{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enablePreCommit",
    "schedule:weekly",
    ":semanticCommits",
    ":semanticPrefixChore",
    ":label(renovate)"
  ],
  "enabledManagers": [
    "bazel-module",
    "bazelisk",
    "github-actions",
    "pre-commit"
  ],
  "ignoreDeps": [
    "bazel_skylib",
    "buildozer",
    "bzip2",
    "macos-15",
    "nlohmann_json",
    "platforms",
    "protobuf",
    "rules_cc",
    "rules_python",
    "ubuntu-24.04",
    "windows-2022",
    "xz",
    "zlib",
    "zstd"
  ],
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prHourlyLimit": 6
}
